# ==============================================================
# SAY AI ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure your keys
# ==============================================================

# OpenRouter server-side secret (used by Cloudflare Pages Functions for chat)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="openrouter/free"

# Optional Google Gemini key for local Express development only
GEMINI_API_KEY="your_gemini_api_key_here"

# Application URL
APP_URL="http://localhost:3000"

# Supabase Authentication & Database
# Leave blank to run in Local / Guest Offline Mode
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Server Port
PORT=3000
